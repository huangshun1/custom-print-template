{
  "name": "custom-print-template",
  "version": "1.0.0",
  "description": "基于Vue 3的可视化打印模板设计器组件",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "print",
    "template",
    "designer",
    "hiprint",
    "element-plus"
  ],
  "author": "hs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huangshun1/custom-print-template"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "element-plus": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "element-plus": {
      "optional": true
    }
  },
  "dependencies": {
    "vue-plugin-hiprint": "^0.0.60",
    "jquery": "^3.7.1",
    "codemirror": "^6.0.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "@element-plus/icons-vue": "^2.3.1",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.7.2",
    "sass": "^1.70.0",
    "typescript": "^5.3.3",
    "vue-tsc": "^1.8.27",
    "@types/jquery": "^3.5.29"
  },
  "scripts": {
    "build": "vite build",
    "build:types": "vue-tsc --noEmit",
    "clean": "rimraf dist node_modules",
    "prepublishOnly": "pnpm build"
  }
}
